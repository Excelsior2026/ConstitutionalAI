{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RationaleObject",
  "type": "object",
  "properties": {
    "decision_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "context": {"type": "object"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "reversible": {"type": "boolean"}
        },
        "required": ["id", "description", "reversible"]
      }
    },
    "scores": {"type": "object"},
    "critics": {"type": "object"},
    "aggregation": {"type": "object"},
    "uncertainty_gate": {"type": "object"},
    "sensitivity": {"type": "array"},
    "oversight": {"type": "object"},
    "audit_hash": {"type": "string"},
    "constitution_hash": {"type": "string"}
  },
  "required": ["decision_id", "timestamp", "candidates", "scores", "aggregation", "audit_hash", "constitution_hash"]
}
